{
	"name": "wpbp/wordpress-plugin-boilerplate-powered",
	"description": "Wordpress Plugin Boilerplate with steroids!",
	"license": "GPL-3.0-or-later",
	"type": "wordpress-plugin",
	"authors": [
		{
			"name": "author_name",
			"email": "author@example.com",
			"homepage": "https://author-url.test"
		}
	],
	"homepage": "https://github.com/WPBP/WordPress-Plugin-Boilerplate-Powered",
	"require": {
		"php": ">=8.0",
		"cmb2/cmb2": "~2.10.0",
		"composer/installers": "^1.0",
		"decodelabs/tagged": "^0.13.0",
		"freemius/wordpress-sdk": "~2.7.3",
		"inpsyde/assets": "^2.8",
		"inpsyde/wp-context": "~1.5.0",
		"johnbillion/extended-cpts": "~5.0.8",
		"julien731/wp-review-me": "dev-develop",
		"micropackage/requirements": "^1.2",
		"origgami/cmb2-grid": "dev-master",
		"seravo/wp-custom-bulk-actions": "dev-master",
		"stevegrunwell/wp-cache-remember": "dev-master",
		"wpbp/cpt_columns": "~1.0.0",
		"wpbp/cronplus": "~1.0.0",
		"wpbp/debug": "~1.1.0",
		"wpbp/i18n-notice": "dev-main",
		"wpbp/page-madness-detector": "^1.0",
		"wpbp/pointerplus": "~1.0.0",
		"wpbp/template": "~1.0.0",
		"wpdesk/wp-notice": "^3.2",
		"yahnis-elsts/plugin-update-checker": "^5.4"
	},
	"require-dev": {
		"codeatcode/codeatcs": "^1.0",
		"codeception/codeception": "^5.0",
		"codeception/module-asserts": "^2.0",
		"codeception/module-cli": "^2.0",
		"codeception/module-db": "^3.0",
		"codeception/module-filesystem": "^3.0",
		"codeception/module-phpbrowser": "^3.0",
		"codeception/module-rest": "^3.0",
		"codeception/module-webdriver": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "1.0.0",
		"ergebnis/composer-normalize": "^2.45",
		"lucatume/function-mocker": "^1.0",
		"lucatume/wp-browser": "^4.0",
		"php-stubs/wp-cli-stubs": "^2.0",
		"phpro/grumphp": "^1.13",
		"phpunit/phpunit": "^9.6",
		"szepeviktor/phpstan-wordpress": "^1.1.6"
	},
	"scripts": {
		"prefix-namespaces": [
			"sh -c 'test -f ./bin/strauss.phar || mkdir -p bin && curl -o bin/strauss.phar -L -C - https://github.com/BrianHenryIE/strauss/releases/latest/download/strauss.phar'",
			"@php bin/strauss.phar",
			"@composer dump-autoload"
		],
		"rewrite-call-sites": [
			"sh -c 'test -f ./bin/strauss.phar || mkdir -p bin && curl -o bin/strauss.phar -L -C - https://github.com/BrianHenryIE/strauss/releases/latest/download/strauss.phar'",
			"@php bin/strauss.phar --updateCallSites=true",
			"@composer dump-autoload"
		],
		"post-install-cmd": [
			"@prefix-namespaces"
		],
		"post-update-cmd": [
			"@prefix-namespaces"
		],
		"post-autoload-dump": [
			"sh -c 'test -f ./bin/strauss.phar || exit 0; php bin/strauss.phar include-autoloader'"
		]
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"psr-4": {
			"Plugin_Name\\Ajax\\": "ajax/",
			"Plugin_Name\\Backend\\": "backend/",
			"Plugin_Name\\Cli\\": "cli/",
			"Plugin_Name\\Engine\\": "engine/",
			"Plugin_Name\\Frontend\\": "frontend/",
			"Plugin_Name\\Integrations\\": "integrations/",
			"Plugin_Name\\Internals\\": "internals/",
			"Plugin_Name\\Rest\\": "rest/"
		},
		"files": [
			"vendor/wp-custom-bulk-actions/custom-bulk-actions.php"
		]
	},
	"config": {
		"allow-plugins": {
			"composer/installers": true,
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"ergebnis/composer-normalize": true,
			"phpro/grumphp": true
		},
		"platform": {
			"php": "8.0",
			"ext-intl": "8.0.0"
		}
	},
	"extra": {
		"installer-paths": {
			"vendor/{$name}/": [
				"cmb2/cmb2",
				"origgami/cmb2-grid",
				"stevegrunwell/wp-cache-remember",
				"seravo/wp-custom-bulk-actions"
			]
		},
		"strauss": {
			"target_directory": "vendor-prefixed",
			"namespace_prefix": "WPBP\\Vendor\\",
			"classmap_prefix": "WPBP_Vendor_",
			"constant_prefix": "WPBP_VENDOR_",
			"packages": [
				"cmb2/cmb2",
				"decodelabs/tagged",
				"inpsyde/assets",
				"inpsyde/wp-context",
				"johnbillion/extended-cpts",
				"micropackage/requirements",
				"wpbp/cpt_columns",
				"wpbp/cronplus",
				"wpbp/debug",
				"wpbp/i18n-notice",
				"wpbp/page-madness-detector",
				"wpbp/pointerplus",
				"wpbp/template",
				"wpdesk/wp-notice",
				"yahnis-elsts/plugin-update-checker",
				"origgami/cmb2-grid",
				"seravo/wp-custom-bulk-actions",
				"stevegrunwell/wp-cache-remember"
			],
			"exclude_from_prefix": {
				"namespaces": [
					"DecodeLabs"
				],
				"packages": [
				"freemius/wordpress-sdk",
				"julien731/wp-review-me"
				]
			},
			"exclude_from_copy": {
				"packages": [
					"freemius/wordpress-sdk",
					"julien731/wp-review-me",
					"composer/installers",
					"decodelabs/tagged",
					"decodelabs/veneer",
					"decodelabs/dictum",
					"decodelabs/elementary",
					"decodelabs/collections",
					"decodelabs/coercion",
					"decodelabs/exceptional",
					"decodelabs/fluidity",
					"decodelabs/gadgets",
					"decodelabs/glitch-support"
				]
			},
			"update_call_sites": false,
			"include_root_autoload": false,
			"optimize_autoloader": true,
			"delete_vendor_packages": false,
			"exclude_git_files": true
		}
	}
}
